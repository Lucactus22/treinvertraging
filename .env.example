# Copy to .env for plain `docker compose` (read via an optional env_file), or set these variables in
# the Portainer stack editor instead. Never commit .env: this repository is public.

# Paths inside the container; normally leave as is.
DATA_DIR=/data
CONFIG_DIR=/config

# dry_run | approve | auto. Start with approve.
CLAIM_MODE=approve
AUTO_AFTER_N_APPROVED=5

TIMEZONE=Europe/Amsterdam

# Optional NS API portal subscription key (arrivals archive).
NS_API_KEY=

# Apprise URLs, comma separated, e.g. tgram://BOT_TOKEN/CHAT_ID,ntfys://my-topic
APPRISE_URLS=

# HTTP Basic auth for the web UI (port 8080). Choose a strong password.
WEB_USERNAME=admin
WEB_PASSWORD=change-me

# Used in notification links, e.g. http://192.168.1.50:8080
PUBLIC_URL=http://localhost:8080

# false = headed Chromium in Xvfb (recommended against bot protection).
HEADLESS=false
# Daily run window (local time).
RUN_WINDOW=07:00-22:00

# Password for the noVNC / x11vnc takeover session (port 6080).
VNC_PASSWORD=change-me-too

# Address the web UI (8080) and noVNC (6080) bind to. Set this to your LAN or Tailscale IP;
# never expose these ports to the internet.
# BIND_ADDR=0.0.0.0

# --- Optional: a mailbox for verification codes (NS / OV-chipkaart) and NS confirmation mails -------
# Use an app password. Leave empty to enter codes manually in the web UI.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX

# Order in which claim channels are tried: gtbv = public form, mijnns = prefilled form in Mijn NS.
# SUBMIT_CHANNELS=gtbv,mijnns

# Docker image tag to run when using the GHCR image (latest, a version like v0.1.0, or a commit sha).
# TAG=latest
